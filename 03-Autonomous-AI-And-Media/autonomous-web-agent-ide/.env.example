# Autonomous Web-Agent IDE Configuration

# Ports
BACKEND_PORT=3001
FRONTEND_PORT=5173
AGENT_PORT=5005

# Paths (Relative to repository root or absolute)
WORKSPACE_ROOT=./workspace
BROWSER_PROFILE_DIR=./browser-profile
DATABASE_PATH=./data/agent.sqlite
LOG_LEVEL=INFO

# Provider & Execution Settings
DEFAULT_LLM_PROVIDER=mock_provider
# Set to deepseek_web or generic_web for real browser LLM operation:
# DEFAULT_LLM_PROVIDER=deepseek_web
DEEPSEEK_WEB_URL=https://chat.deepseek.com
BROWSER_HEADLESS=false
MAX_AGENT_ITERATIONS=30
MAX_REPAIR_ATTEMPTS=4
MAX_SAME_ERROR=3
COMMAND_TIMEOUT=120
APPROVAL_MODE=SAFE
