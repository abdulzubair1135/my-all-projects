# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python environment & caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Browser profiles & session state
browser-profile/
**/browser-profile/
!browser-profile/.gitkeep
**/.delivery/
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
!data/.gitkeep

# Workspaces
workspace/*
!workspace/.gitkeep

# Environment variables
.env
.env.local
.env.production

# Build artifacts
dist/
build/
coverage/

# Logs
logs/
*.log

# Scratch and temporary testing
scratch/

# OS specific
.DS_Store
Thumbs.db
