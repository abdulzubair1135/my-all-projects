# ============================================================
# AUTO YT GENERATOR — Environment Variables Template
# Copy this to .env and fill in your keys
# ============================================================

# ---- AI Providers ----
# At least ONE AI provider is required for script/scene generation
# Leave unused providers blank — the system will skip them

GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- TTS Providers ----
# ElevenLabs (best quality) — optional
ELEVENLABS_API_KEY=

# Google Cloud TTS — optional (uses same key as Gemini if GCP)
GOOGLE_CLOUD_TTS_KEY=

# ---- Application ----
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
