# Personal Life Vault Configuration
PORT=8088
HOST=0.0.0.0
NODE_ENV=production

# Storage Path (default on Windows is C:\Vault)
VAULT_STORAGE_ROOT=C:\Vault

# Database Location
DATABASE_FILE=C:\Vault\vault.db

# Timezone for date indexing and daily vaults
VAULT_TIMEZONE=Asia/Kolkata

# Master registration key required for Android device registration
# Change this to a secure random string in production
ADMIN_REGISTRATION_KEY=ChangeThisMasterKeyBeforeProductionSync123!
