            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": 1,\n  \"startDate\": \"2026-09-01\",\n  \"endDate\": \"2026-09-05\",\n  \"deliveryType\": \"Self Pickup\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings"]
