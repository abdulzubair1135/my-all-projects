{
  "name": "rentany-backend",
  "version": "1.0.0",
  "description": "Deployable REST API backend server for RentAny Peer-to-Peer Neighborhood Rental Marketplace App",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
