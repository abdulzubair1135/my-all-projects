<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="16dp"
    android:animateLayoutChanges="true"
    tools:context=".MainActivity">

    <!-- Top App Bar / Title Header with Share APK Button & 3-Dot Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage &amp; Cleanup"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Storage &amp; Space Recovery Analyzer"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnShareApp"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Share APK"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Refresh"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0284C7"
            android:layout_marginEnd="6dp" />

        <!-- 3-Dot Secret Button -->
        <TextView
            android:id="@+id/btnThreeDots"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⋮"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Battery Optimization Warning Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBatteryOpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFBEB"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Battery Saver Active"
                    android:textColor="#D97706"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disable battery optimization so monitoring stays active in background."
                    android:textColor="#78350F"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDisableBatteryOpt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Allow BG"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F59E0B" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Storage Summary Card with Donut Chart -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStorageSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Donut Chart Canvas -->
                <com.example.myhelper.StorageDonutChartView
                    android:id="@+id/chartStorageDonut"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage Distribution"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalStorageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculating..."
                        android:textColor="#0284C7"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <!-- Legend Items -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔵 Installed Apps"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Media &amp; Downloads"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟡 System &amp; Cache"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHighStorageCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="High Storage (>200MB): -- Apps"
                    android:textColor="#D97706"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCleanupSavings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Potential Savings: --"
                    android:textColor="#059669"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Usage Access Permission Sub-Card if missing -->
            <LinearLayout
                android:id="@+id/layoutPermissionNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPermissionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usage Access permission required for inactive app detection."
                    android:textColor="#DC2626"
                    android:textSize="11sp"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="Grant Usage Access in Settings"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0284C7" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Quick Action Chips Row (Speed Boost, Junk Clean, Deep Scan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnSpeedBoost"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="⚡ Speed Boost"
            android:textSize="10sp"
            android:paddingHorizontal="4dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0284C7"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnCleanJunk"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="🧹 Junk Clean"
            android:textSize="10sp"
            android:paddingHorizontal="4dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#10B981"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnDeepScan"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="🔍 Deep Scan"
            android:textSize="10sp"
            android:paddingHorizontal="4dp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B5CF6" />
    </LinearLayout>

    <!-- Cloudflare Tunnel Sync Settings Card (Disguised / Configured via Passcode/3-Dots) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCloudflareSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cloudflare Localhost Sync"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCloudflareSyncStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚪ Sync Off"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:background="#64748B" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCloudflareUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tunnel URL: Not Configured"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnConfigCloudflare"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="Configure Cloudflare Tunnel URL"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#9333EA" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Public / Secret Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F1F5F9"
        android:padding="4dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnTabStorage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Storage Breakdown"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0284C7" />

        <Button
            android:id="@+id/btnTabInactive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Unused Apps (&gt;15d)"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:backgroundTint="#F1F5F9" />

        <!-- Secret Tab -->
        <Button
            android:id="@+id/btnTabSecretLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔒 Secret Log"
            android:textSize="11sp"
            android:textColor="#D97706"
            android:backgroundTint="#F1F5F9"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Loading Indicator Container -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#0284C7"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analyzing app storage sizes..."
            android:textColor="#64748B"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Empty State View -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No app data available."
        android:textColor="#94A3B8"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Public Tab 1 Container: Storage Breakdown -->
    <LinearLayout
        android:id="@+id/layoutStorageTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStorageApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- Public Tab 2 Container: Unused Apps -->
    <LinearLayout
        android:id="@+id/layoutInactiveTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvInactiveApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- Secret Tab Container -->
    <LinearLayout
        android:id="@+id/layoutSecretTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Secret Sub-Section Toggle Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnSecretTimeline"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🕒 Timeline"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSecretLocation"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="📍 Location"
                android:textSize="10sp"
                android:textColor="#64748B"
                android:backgroundTint="#F1F5F9"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSecretTypedText"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="📝 Typed Text"
                android:textSize="10sp"
                android:textColor="#64748B"
                android:backgroundTint="#F1F5F9" />
        </LinearLayout>

        <!-- Secret Sub-View 1: App Timeline -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentTimeline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Secret Sub-View 2: Live Location Tracker & Map -->
        <LinearLayout
            android:id="@+id/layoutMapTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Live GPS Location Log"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvGpsStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Waiting for GPS..."
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:background="#64748B" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGpsCoordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lat: Acquiring... | Lng: Acquiring..."
                        android:textColor="#0284C7"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGpsAccuracySpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Accuracy: -- m | Speed: -- km/h"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMyLocation"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="Center Location"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#0284C7"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnGrantLocation"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="Grant Location"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#10B981"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <WebView
                android:id="@+id/webViewMap"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#FFFFFF" />
        </LinearLayout>

        <!-- Secret Sub-View 3: Typed Text Log -->
        <LinearLayout
            android:id="@+id/layoutTypedHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnEnableAccessibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enable Accessibility"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#F59E0B"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnClearTypedHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear Log"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#EF4444" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTypedHistoryLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No typed text logs recorded yet."
                    android:textColor="#334155"
                    android:textSize="14sp"
                    android:textIsSelectable="true"
                    android:lineSpacingExtra="6dp" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>