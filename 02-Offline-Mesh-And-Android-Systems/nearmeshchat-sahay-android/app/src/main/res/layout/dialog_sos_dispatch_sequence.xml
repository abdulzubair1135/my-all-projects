<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="20dp">

    <!-- Header Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_red">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🚨"
                android:textSize="22sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDispatchHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMERGENCY SOS DISPATCH"
                android:textColor="#DC2626"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDispatchSubheader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transmitting distress beacon across Sahay Grid"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbDispatchSpinner"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true"
            android:indeterminateTint="#DC2626" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginVertical="14dp" />

    <!-- Step 1: GPS -->
    <LinearLayout
        android:id="@+id/rowStepGps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/iconStepGps"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_pill_soft"
            android:gravity="center"
            android:text="📍"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1: GPS Coordinates Acquired"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDispatchGpsCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lat: 23.0305° N, Lng: 72.5801° E (Ahmedabad)"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusStepGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ OK"
            android:textColor="#16A34A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Step 2: Beacon Encrypted -->
    <LinearLayout
        android:id="@+id/rowStepBeacon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/iconStepBeacon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_pill_soft"
            android:gravity="center"
            android:text="🔐"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 2: Distress Beacon Cryptographic Payload"
                android:textColor="#0F172A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDispatchBeaconDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payload Packaged • Event UUID Generated • TTL 10 Hops"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusStepBeacon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ READY"
            android:textColor="#16A34A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Step 3: Transmission Routing (Online Cloud vs BLE Multi-Hop Relay) -->
    <LinearLayout
        android:id="@+id/cardDispatchRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FEF2F2"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDispatchRouteIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDispatchRouteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="TRANSMITTING DISPATCH..."
                android:textColor="#DC2626"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Relay Path Visualizer -->
        <TextView
            android:id="@+id/tvDispatchRelayChain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:text="YOU ➔ [Direct Cloud Link] ➔ DISASTER COMMAND CENTER"
            android:textColor="#1E293B"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDispatchRouteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Connecting to Gujarat State Disaster Management Authority..."
            android:textColor="#7F1D1D"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelSos"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#FEE2E2"
            android:text="CANCEL SOS"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDoneSos"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#DC2626"
            android:text="CLOSE / MONITOR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
