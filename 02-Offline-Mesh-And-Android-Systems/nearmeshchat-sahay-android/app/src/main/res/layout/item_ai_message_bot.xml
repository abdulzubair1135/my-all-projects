<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="6dp"
    android:gravity="top">

    <!-- Robot Avatar -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/circle_avatar"
        android:backgroundTint="@color/primary_light"
        android:layout_marginEnd="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_ai"
            app:tint="@color/primary_dark" />
    </FrameLayout>

    <!-- Content Bubble Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="@color/bg_card_highlight"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvBotHeaderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 Nexus AI"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Collapsible Thinking Process Box -->
            <LinearLayout
                android:id="@+id/llThoughtContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_thought_box"
                android:padding="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llThoughtHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvThoughtIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💭"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvThoughtTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Thinking Process"
                        android:textColor="#4B5563"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvThoughtToggleArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲"
                        android:textColor="#6B7280"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:id="@+id/vThoughtDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginVertical="6dp" />

                <TextView
                    android:id="@+id/tvThoughtContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#4B5563"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBotMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Interactive Emergency/Call Action Button -->
            <Button
                android:id="@+id/btnBotAction"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/danger_red"
                android:text="🚨 Trigger Emergency"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvBotTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Horizontal Quick Chips Container -->
        <HorizontalScrollView
            android:id="@+id/hsvChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
