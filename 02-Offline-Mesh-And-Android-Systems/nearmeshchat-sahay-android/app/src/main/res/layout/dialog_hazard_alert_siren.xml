<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FEF2F2"
    android:padding="20dp">

    <!-- Siren Icon & Alert Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_red">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_lock_idle_alarm"
                app:tint="#DC2626" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 OFFICIAL DISASTER ALERT"
                android:textColor="#DC2626"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSirenSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Broadcasted by State Disaster Command Center"
                android:textColor="#991B1B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#FCA5A5"
        android:layout_marginVertical="12dp" />

    <!-- Alert Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvSirenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLASH FLOOD DANGER WARNING"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSirenSeverity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_red"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="SEVERITY: CRITICAL"
            android:textColor="#DC2626"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvSirenMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High water discharge expected in river basin. Relocate immediately to elevated grounds or nearest safe shelter."
            android:textColor="#334155"
            android:textSize="12.5sp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvSirenLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Danger Radius: 15 km from epicenter"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Silence / Acknowledge Button -->
    <Button
        android:id="@+id/btnSilenceSiren"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🔇 SILENCE SIREN &amp; ACKNOWLEDGE"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:fontFamily="sans-serif-black"
        android:backgroundTint="#DC2626" />

</LinearLayout>