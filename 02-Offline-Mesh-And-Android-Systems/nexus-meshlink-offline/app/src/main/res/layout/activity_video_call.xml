<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Peer Remote Video Surface / ImageView -->
    <FrameLayout
        android:id="@+id/flRemoteVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0F1D">

        <!-- Live Remote Video Frame View -->
        <ImageView
            android:id="@+id/ivRemoteVideoFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Default placeholder avatar if video paused/connecting -->
        <LinearLayout
            android:id="@+id/llRemotePlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/circle_avatar"
                android:backgroundTint="@color/accent">

                <TextView
                    android:id="@+id/tvVideoPeerLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="P"
                    android:textColor="@color/text_white"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streaming video via WiFi Direct P2P..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Top Overlay Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnVideoBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_white"
            android:background="?selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVideoPeerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Priya Mehta"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVideoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:01:45 • WiFi Direct 720p"
                android:textColor="@color/online_green"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="#3300C896"
            android:text="● HD LIVE"
            android:textColor="@color/accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Telemetry HUD Bar (Speed, FPS, Latency/RTT, Pkts) -->
    <LinearLayout
        android:id="@+id/llVideoTelemetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginTop="72dp"
        android:layout_marginStart="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="#800B132B"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/tvVideoFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 0 FPS"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="#44FFFFFF"
            android:layout_marginHorizontal="6dp" />

        <TextView
            android:id="@+id/tvVideoSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 0 KB/s"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="#44FFFFFF"
            android:layout_marginHorizontal="6dp" />

        <TextView
            android:id="@+id/tvVideoPing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📶 0 ms"
            android:textColor="@color/text_white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- PIP Local Camera Preview (Self) -->
    <androidx.cardview.widget.CardView
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_alignParentEnd="true"
        android:layout_above="@+id/llVideoControls"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#1E293B">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextureView
                android:id="@+id/textureLocalCamera"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvLocalPipLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:text="YOU"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#66000000"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/llVideoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="20dp">

        <!-- Mute -->
        <FrameLayout
            android:id="@+id/btnVideoMute"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="#334155"
            android:clickable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/text_white" />
        </FrameLayout>

        <!-- Flip Camera -->
        <FrameLayout
            android:id="@+id/btnVideoFlip"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="#334155"
            android:layout_marginStart="14dp"
            android:clickable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="@color/text_white" />
        </FrameLayout>

        <!-- Video Off -->
        <FrameLayout
            android:id="@+id/btnVideoToggleCam"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="#334155"
            android:layout_marginStart="14dp"
            android:clickable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/text_white" />
        </FrameLayout>

        <!-- End Call -->
        <FrameLayout
            android:id="@+id/btnVideoEnd"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="@color/danger_red"
            android:layout_marginStart="18dp"
            android:clickable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_white" />
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>
