<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg_secondary">

    <!-- Top WhatsApp-style Chat Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_primary"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <FrameLayout
            android:id="@+id/flChatAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_avatar_circle">

            <TextView
                android:id="@+id/tvChatAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="N"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/ivChatAvatarPic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peer Name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvChatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Online • BLE Mesh"
                android:textColor="@color/online_green"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Video Call Icon -->
        <ImageView
            android:id="@+id/btnVideoCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/primary"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp" />

        <!-- Voice Call Icon -->
        <ImageView
            android:id="@+id/btnVoiceCall"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_call"
            app:tint="@color/primary"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Network Routing Notice Banner -->
    <LinearLayout
        android:id="@+id/llRoutingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_soft"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRoutingBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Active: BLE Mesh • Gossip Relay • Zero Internet"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="6dp"
        android:paddingTop="8dp"
        android:clipToPadding="false" />

    <!-- Sticky Bottom WhatsApp Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="bottom"
        android:background="@color/bg_secondary">

        <!-- Input Container Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:minHeight="44dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/etMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Message…"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp"
                android:maxLines="4"
                android:layout_marginStart="8dp" />

            <ImageView
                android:id="@+id/btnAttach"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_share"
                app:tint="@color/text_secondary"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/btnCamera"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/text_secondary"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="2dp" />
        </LinearLayout>

        <!-- Send / Mic Circular Button -->
        <FrameLayout
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_sos_circle"
            android:backgroundTint="@color/primary"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/ivSendIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/text_white" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
