<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/llCallTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnCallBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_white"
            android:background="?selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MeshLink P2P Call"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/tvSignalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WiFi Direct P2P"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Contact Info & Avatar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCallPeerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Priya Mehta"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallTransportBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="#250A84FF"
            android:text="Peer-to-Peer • WiFi Direct"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="8dp" />

        <!-- Large Glowing Avatar -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="#2000C896">

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_avatar"
                android:backgroundTint="@color/accent">

                <TextView
                    android:id="@+id/tvCallAvatarLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="P"
                    android:textColor="@color/text_white"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivCallAvatarPic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <!-- Call Timer / Status -->
        <TextView
            android:id="@+id/tvCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected • 00:02:34"
            android:textColor="@color/online_green"
            android:textSize="14sp"
            android:layout_marginTop="20dp" />

        <!-- Realtime Mesh Telemetry Pill (Speed, Latency/RTT, Pkts) -->
        <LinearLayout
            android:id="@+id/llVoiceTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="#2610B981"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvVoiceBitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 0.0 KB/s"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:background="#44FFFFFF"
                android:layout_marginHorizontal="8dp" />

            <TextView
                android:id="@+id/tvVoicePing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📶 0 ms"
                android:textColor="@color/text_white"
                android:textSize="11sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:background="#44FFFFFF"
                android:layout_marginHorizontal="8dp" />

            <TextView
                android:id="@+id/tvVoicePackets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 0 pkt/s"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbAudioSignal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="4dp"
            android:progress="80"
            android:progressTint="@color/accent"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Direct peer connection • Zero relay lag"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Bottom Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Mute -->
        <FrameLayout
            android:id="@+id/btnCallMute"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="#334155"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivMuteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/text_white" />
        </FrameLayout>

        <!-- Speaker -->
        <FrameLayout
            android:id="@+id/btnCallSpeaker"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="#334155"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/text_white" />
        </FrameLayout>

        <!-- Switch to Video -->
        <FrameLayout
            android:id="@+id/btnCallSwitchVideo"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="@color/accent"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/text_white" />
        </FrameLayout>

        <!-- End Call (Red) -->
        <FrameLayout
            android:id="@+id/btnCallEnd"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="@color/danger_red"
            android:layout_marginStart="20dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_white" />
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>
