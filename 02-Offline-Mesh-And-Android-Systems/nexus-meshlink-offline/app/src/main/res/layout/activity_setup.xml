<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_secondary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- ═══ NEXUS BRANDING HEADER ═══ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_nexus_logo"
                android:contentDescription="Nexus Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nexus"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="OFFLINE MESH NETWORK"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chat, Calls, Files &amp; Browser without Internet"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- ═══ AVATAR & PHOTO PICKER CONTAINER ═══ -->
        <FrameLayout
            android:id="@+id/flSetupAvatarContainer"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground">

            <!-- Circle Avatar Background -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:id="@+id/tvSelectedEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="👤"
                    android:textSize="48sp" />

                <ImageView
                    android:id="@+id/ivSetupProfilePic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Camera Badge at Bottom-Right -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_camera_badge"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📷"
                    android:textSize="14sp" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/btnPickSetupPhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap to Choose Custom Photo"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />

        <!-- ═══ QUICK EMOJI AVATAR PICKER ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="OR CHOOSE AN AVATAR:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/emoji1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="22sp"
                android:background="@drawable/bg_emoji_selected"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/emoji2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⚡"
                android:textSize="22sp"
                android:background="@drawable/bg_emoji_normal"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/emoji3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="🛡️"
                android:textSize="22sp"
                android:background="@drawable/bg_emoji_normal"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/emoji4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="🧑‍💻"
                android:textSize="22sp"
                android:background="@drawable/bg_emoji_normal"
                android:layout_marginHorizontal="4dp" />

            <TextView
                android:id="@+id/emoji5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="🦺"
                android:textSize="22sp"
                android:background="@drawable/bg_emoji_normal"
                android:layout_marginHorizontal="4dp" />
        </LinearLayout>

        <!-- ═══ ENHANCED CRYPTOGRAPHIC NODE ID CARD (DEBUG BOX) ═══ -->
        <LinearLayout
            android:id="@+id/cardMeshIdContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_node_id_card"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔐"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CRYPTOGRAPHIC NODE ID"
                    android:textColor="@color/green_text"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:id="@+id/btnCopyMeshId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP TO COPY"
                    android:textColor="@color/primary_dark"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_soft"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMyMeshId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="mesh@generating..."
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="End-to-End Encrypted (RSA-2048 / AES-GCM) • Zero Cloud"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ═══ INPUT FIELDS (OUTLINED MODERN STYLE) ═══ -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/primary"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="@color/bg_card"
            app:hintTextColor="@color/primary"
            android:textColorHint="@color/text_secondary"
            android:hint="Your Name or Call Sign">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/primary"
            app:boxStrokeWidth="1.5dp"
            app:boxBackgroundColor="@color/bg_card"
            app:hintTextColor="@color/primary"
            android:textColorHint="@color/text_secondary"
            android:hint="Bio / Emergency Role (e.g. Doctor, Helper)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ═══ ROLE SELECTOR CARDS ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SELECT ROLE IN MESH:"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbCitizen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/selector_role_card"
                android:button="@null"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"
                android:text="Citizen / Peer Node"
                android:checked="true"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <RadioButton
                android:id="@+id/rbVolunteer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/selector_role_card"
                android:button="@null"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp"
                android:text="Rescue / Helper Node"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </RadioGroup>

        <!-- ═══ START ACTION BUTTON ═══ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:text="Start Nexus"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/primary"
            app:elevation="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Zero phone number, OTP, or cloud sign-in required."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
