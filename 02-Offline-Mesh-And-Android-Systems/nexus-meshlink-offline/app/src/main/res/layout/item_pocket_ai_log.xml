<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:layout_marginBottom="8dp"
    android:padding="10dp">

    <!-- Row 1: Time, Client IP, Endpoint, Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLogTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:32:01"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvLogClient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="192.168.43.25"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/tvLogEndpoint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="/api/chat"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/tvLogDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.2s"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvLogStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="200"
            android:textColor="@color/text_white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_badge_green" />
    </LinearLayout>

    <!-- Row 2: Prompt Snippet -->
    <TextView
        android:id="@+id/tvLogPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explain DBMS and Primary Key with example..."
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="5dp" />

</LinearLayout>
