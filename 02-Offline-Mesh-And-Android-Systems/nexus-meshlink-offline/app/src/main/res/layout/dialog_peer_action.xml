<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modern"
    android:padding="22dp"
    android:gravity="center_horizontal"
    android:elevation="12dp">

    <!-- Avatar -->
    <TextView
        android:id="@+id/tvPeerAvatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:text="P"
        android:textColor="#15803D"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_avatar_circle"
        android:backgroundTint="#DCFCE7" />

    <!-- Peer Name -->
    <TextView
        android:id="@+id/tvPeerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Peer Name"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <!-- Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓ VERIFIED MESH NODE"
        android:textColor="#15803D"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="#DCFCE7"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:layout_marginTop="6dp" />

    <!-- Details Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="#F9FAFB"
        android:padding="14dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPeerNodeId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Node ID: ..."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvPeerKeyFingerprint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key: ..."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Buttons -->
    <Button
        android:id="@+id/btnOpenChat"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="💬 Open Offline Chat"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="@color/primary" />

    <Button
        android:id="@+id/btnClosePeerDialog"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="#F3F4F6"
        style="?android:attr/borderlessButtonStyle" />

</LinearLayout>
