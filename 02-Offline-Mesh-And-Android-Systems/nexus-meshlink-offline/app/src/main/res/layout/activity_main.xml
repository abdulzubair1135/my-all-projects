<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_secondary">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        app:elevation="0dp">

        <!-- ═══ TOP APP BAR: NEXUS AT VERY TOP & MESH SCANNING BELOW ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_primary"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- ROW 1: NEXUS BRAND AT VERY TOP + ACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Logo Icon -->
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_nexus_logo"
                    android:contentDescription="Nexus Logo" />

                <!-- Nexus Title (At the very top!) -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nexus"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginStart="10dp" />

                <!-- QR Scanner Action -->
                <ImageView
                    android:id="@+id/btnHeaderQrScanner"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_qr_code_scanner"
                    app:tint="@color/primary"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="Scan Peer QR Code" />

                <!-- Direct Settings Icon -->
                <ImageView
                    android:id="@+id/btnHeaderDirectSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="7dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/text_secondary"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="Settings" />

                <!-- Profile Avatar Quick Edit Button -->
                <FrameLayout
                    android:id="@+id/flHeaderMyProfile"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_avatar_circle"
                    android:foreground="?selectableItemBackground">

                    <TextView
                        android:id="@+id/tvHeaderMyEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="U"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/ivHeaderMyPic"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- ROW 2: MESH SCANNING PILL DIRECTLY BELOW NEXUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:id="@+id/llMeshStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_pill_soft"
                    android:paddingHorizontal="10dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?selectableItemBackground"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dotMeshStatus"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/circle_avatar"
                        android:backgroundTint="@color/online_green" />

                    <TextView
                        android:id="@+id/tvMeshStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mesh: Scanning…"
                        android:textColor="@color/green_text"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Dedicated Mesh Refresh Action Pill -->
                <LinearLayout
                    android:id="@+id/btnRefreshMesh"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_blue"
                    android:paddingHorizontal="10dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?selectableItemBackground"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRefreshMeshIcon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvRefreshMeshLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh Mesh"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:layout_marginStart="5dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Fragment Container for Main Tabs -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Floating SOS Action Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabSos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="72dp"
        android:text="SOS"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        app:icon="@android:drawable/stat_notify_error"
        app:iconTint="@color/text_white"
        app:backgroundTint="@color/danger_red"
        app:elevation="6dp" />

    <!-- ═══ SLEEK MODERN ICON-ONLY BOTTOM NAVIGATION BAR ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:elevation="8dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@color/bg_primary"
            app:tabIndicatorColor="@color/primary"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorGravity="top"
            app:tabIconTint="@color/nav_icon_selector"
            app:tabRippleColor="@null"
            app:tabMode="fixed"
            app:tabGravity="fill">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_nav_chats" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_nav_calls" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_nav_radar" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_nav_browser" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_nav_ai" />
        </com.google.android.material.tabs.TabLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
