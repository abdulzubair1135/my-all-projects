<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modern"
    android:padding="22dp"
    android:elevation="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⚡"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="#F0FDF4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Qwen AI Model"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose neural network parameter size"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="12dp" />

    <!-- Model 1: 0.6B -->
    <LinearLayout
        android:id="@+id/btnModel06B"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="#F9FAFB"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="⚡"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#FEF3C7" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qwen3 0.6B (~395 MB)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultra Fast • Minimal RAM usage • Battery Saver"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Model 2: 1.7B -->
    <LinearLayout
        android:id="@+id/btnModel17B"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="#F0FDF4"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🧠"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#DCFCE7" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qwen3 1.7B (~1.05 GB)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEST"
                    android:textColor="#15803D"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_soft"
                    android:backgroundTint="#DCFCE7"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balanced • Hinglish specialist • Recommended"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Model 3: 4B -->
    <LinearLayout
        android:id="@+id/btnModel4B"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="#F9FAFB"
        android:padding="14dp"
        android:layout_marginBottom="14dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🚀"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#F3F4F6" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qwen3 4B (~2.45 GB)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deep Reasoning • 6GB+ RAM Flagships"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnQuickModelSettings"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Manage Models ⚙️"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="#F0FDF4"
            android:layout_marginEnd="6dp"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnQuickModelCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="#F3F4F6"
            android:layout_marginStart="6dp"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

</LinearLayout>
