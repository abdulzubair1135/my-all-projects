<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_chat">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/llAiHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="@color/primary_light">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_ai"
                app:tint="@color/primary_dark" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nexus AI"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Offline • Nexus Local Brain"
                android:textColor="@color/green_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- PocketAI Server Action -->
        <FrameLayout
            android:id="@+id/btnPocketAiServer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?selectableItemBackgroundBorderless"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_browser"
                app:tint="@color/primary"
                android:contentDescription="PocketAI Server Dashboard" />

            <View
                android:id="@+id/dotPocketAiServerRunning"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_status_dot_online"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Settings Gear Action -->
        <ImageView
            android:id="@+id/btnAiSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/text_secondary"
            android:background="?selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Welcome Empty State -->
    <LinearLayout
        android:id="@+id/llAiWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="@color/green_subtle">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_ai"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 Nexus AI"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Small Brain + Powerful Offline Tools\nAsk me anything in Hinglish or English!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <!-- Quick Start Prompt Chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/chipExplain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Recursion kya hai?"
                android:textColor="@color/primary"
                android:background="@drawable/bg_badge_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="12sp"
                android:clickable="true" />

            <TextView
                android:id="@+id/chipCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💻 Java Code"
                android:textColor="@color/primary"
                android:background="@drawable/bg_badge_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:clickable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/chipPpt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 PPT on AI"
                android:textColor="@color/primary"
                android:background="@drawable/bg_badge_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="12sp"
                android:clickable="true" />

            <TextView
                android:id="@+id/chipEmergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🆘 Emergency / First Aid"
                android:textColor="@color/danger_red"
                android:background="@drawable/bg_pill_soft"
                android:backgroundTint="#FEE2E2"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAiMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llAiHeader"
        android:layout_above="@+id/llAiBottomBar"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/llAiBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_primary"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Mode Selector Pill with Dropdown Arrow -->
        <LinearLayout
            android:id="@+id/btnModeSelector"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="#F0FDF4"
            android:gravity="center_vertical"
            android:paddingHorizontal="9dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvActiveModeIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvActiveModeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Qwen"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveModeArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="▾"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etAiInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_soft"
            android:hint="Ask Qwen LLM in Hinglish or English..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:maxLines="4" />

        <FrameLayout
            android:id="@+id/btnAiSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_avatar"
            android:backgroundTint="@color/primary"
            android:clickable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@color/text_white" />
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>
