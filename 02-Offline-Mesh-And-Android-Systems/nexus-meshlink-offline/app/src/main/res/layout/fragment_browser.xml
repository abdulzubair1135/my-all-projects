<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_secondary">

    <!-- Top Address Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_primary"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBrowserBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/text_secondary"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp" />

        <ImageView
            android:id="@+id/btnBrowserForward"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/text_secondary"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp" />

        <!-- URL Input Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_chip"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:layout_marginHorizontal="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etBrowserUrl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:text="http://192.168.137.1:8888"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:inputType="textUri"
                android:maxLines="1"
                android:imeOptions="actionGo"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnBrowserGo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/primary"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Laptop Connection Banner (Clean White/Green/Gray) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_surface"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💻"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Laptop Server • Port :8888"
                android:textColor="@color/green_text"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wikipedia &amp; File Vault over Wi-Fi Hotspot"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDefaultServer"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="CONNECT"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            app:cornerRadius="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- WebView Content -->
    <WebView
        android:id="@+id/wvOfflineBrowser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_secondary" />

</LinearLayout>
