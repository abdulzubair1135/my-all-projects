<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="22dp"
    android:gravity="center_horizontal">

    <!-- Emergency Header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[SOS]"
            android:textColor="@color/danger_red"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY SOS"
            android:textColor="@color/danger_red"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Broadcast distress signal to ALL nearby mesh nodes"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- Live GPS Location Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_soft"
        android:backgroundTint="#15EF4444"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_avatar"
                android:backgroundTint="@color/danger_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE GPS COORDINATES ATTACHED"
                android:textColor="@color/danger_red"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSosLocationPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="GPS: 23.0225° N, 72.5714° E (Accuracy: ±10m)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom SOS Message Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/danger_red"
        app:boxStrokeWidth="1.5dp"
        android:hint="Distress Details">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSosReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Immediate emergency assistance required!"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:maxLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Siren Checkbox -->
    <CheckBox
        android:id="@+id/cbTriggerSiren"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Also activate high-frequency acoustic beacon siren"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:checked="false" />

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmDispatchSos"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:text="DISPATCH SOS BROADCAST NOW"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:backgroundTint="@color/danger_red"
        app:elevation="4dp" />

    <TextView
        android:id="@+id/btnCancelSos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp" />

</LinearLayout>
