<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="@drawable/bg_card_rounded"
    android:backgroundTint="#1E293B"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/circle_avatar"
        android:backgroundTint="@color/accent">

        <TextView
            android:id="@+id/tvPeerAvatarLetter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="P"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivPeerAvatarPic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPeerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peer Node"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPeerDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active • Connected via BLE Mesh"
            android:textColor="@color/online_green"
            android:textSize="10sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPeerChatAction"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="CHAT"
        android:textColor="@color/text_white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary"
        app:cornerRadius="16dp" />

</LinearLayout>
