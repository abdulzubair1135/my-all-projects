<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_secondary">

    <!-- Top Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RuVNet Wi-Fi Wave Radar"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRadarScanBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:text="● RuVNet 3D Active"
            android:textColor="@color/green_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Animated Sonar BLE Radar View -->
    <com.example.meshlink.status.BleRadarView
        android:id="@+id/bleRadarView"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

    <!-- Peers In Range Badge -->
    <TextView
        android:id="@+id/tvPeersInRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_soft"
        android:text="Scanning for peers..."
        android:textColor="@color/green_text"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:layout_marginTop="6dp" />

    <!-- Connected Mesh Nodes Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Discovered Mesh Nodes"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp" />

    <!-- Dynamic Peer RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPeersList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp" />

    <!-- Empty State if zero nodes -->
    <LinearLayout
        android:id="@+id/llPeersEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Nodes in Range"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bluetooth Low Energy radio is continuously listening for nearby mesh devices."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
