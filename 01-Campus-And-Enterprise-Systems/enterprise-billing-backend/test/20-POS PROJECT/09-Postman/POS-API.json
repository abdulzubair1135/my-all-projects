    "name": "POS System REST API - BCA Exam",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Cashier",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suresh Kumar\",\n  \"email\": \"suresh@pos.com\",\n  \"password\": \"password123\",\n  \"role\": \"cashier\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pos.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Franchises",
      "item": [
        {
          "name": "Get All Franchises",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/franchises",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "franchises"]
            }
          }
        }
      ]
    },
    {
      "name": "Bills & Invoices",
      "item": [
        {
          "name": "Generate Bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"franchise_id\": 1,\n  \"customer_name\": \"Rohan Sharma\",\n  \"items\": [\n    { \"product_id\": 1, \"quantity\": 2 },\n    { \"product_id\": 2, \"quantity\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/bills",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "bills"]
            }
          }
        }
      ]
    }
  ]
}
