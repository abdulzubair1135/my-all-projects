{
  "name": "01 - User Register Request",
  "request": {
    "method": "POST",
    "header": [
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\n  \"name\": \"Student One\",\n  \"email\": \"student@example.com\",\n  \"password\": \"Password123\"\n}"
    },
    "url": {
      "raw": "http://localhost:5000/api/auth/register",
      "protocol": "http",
      "host": ["localhost"],
      "port": "5000",
      "path": ["api", "auth", "register"]
    }
  },
  "response": [
    {
      "name": "201 Created",
      "status": "Created",
      "code": 201,
      "body": "{\n  \"success\": true,\n  \"message\": \"User registered successfully\",\n  \"data\": {\n    \"id\": 1,\n    \"name\": \"Student One\",\n    \"email\": \"student@example.com\",\n    \"role\": \"customer\"\n  }\n}"
    }
  ]
}
