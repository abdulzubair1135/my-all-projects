from fastapi import FastAPI, HTTPException, status
from fastapi.responses import HTMLResponse
from pydantic import BaseModel
from typing import List, Optional, Dict, Any
import uuid
from datetime import datetime

app = FastAPI(
    title="Falfy Burd Game",
    description="A full-stack Flappy Bird style game with score tracking",
    version="1.0.0"
)

# Game state storage
games = {}
scores = {}

# Generic CRUD storage (for API testing compatibility)
items = {}

class GameState(BaseModel):
    game_id: str
    score: int
    high_score: int
    bird_y: float
    bird_velocity: float
    pipes: List[dict]
    game_over: bool
    started: bool

class ScoreRequest(BaseModel):
    game_id: str
    score: int
    
    class Config:
        json_schema_extra = {
            "example": {
                "game_id": "game_1234567890_abc123def",
                "score": 42
            }
        }

# Generic item model for CRUD tests
class Item(BaseModel):
    name: str
    description: Optional[str] = None
    price: float
    
    class Config:
        json_schema_extra = {
            "example": {
                "name": "Test Item 1",
                "description": "Automated test item",
                "price": 99.9
            }
        }

# HTML frontend
HTML_TEMPLATE = """
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Falfy Burd - Flappy Bird Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Press Start 2P', cursive;
        }
        
        .game-container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.1);
        }
        
        canvas {
            border-radius: 16px;
            display: block;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            background: #87CEEB;
            cursor: pointer;
        }
        
        .score-display {
            color: #fff;
            text-align: center;
            margin-bottom: 15px;
            font-size: 18px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }
        
        .score-display span {
            color: #FFD700;
            font-size: 24px;
        }
        
        .controls {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        
        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 12px;
            font-family: 'Press Start 2P', cursive;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .btn-start {
            background: linear-gradient(135deg, #00b894, #00cec9);
            color: white;
            box-shadow: 0 4px 15px rgba(0,206,201,0.4);
        }
        
        .btn-start:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,206,201,0.6);
        }
        
        .btn-reset {
            background: linear-gradient(135deg, #fd79a8, #e17055);
            color: white;
            box-shadow: 0 4px 15px rgba(225,112,85,0.4);
        }
        
        .btn-reset:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(225,112,85,0.6);
        }
        
        .btn-score {
            background: linear-gradient(135deg, #fdcb6e, #f39c12);
            color: white;
            box-shadow: 0 4px 15px rgba(243,156,18,0.4);
        }
        
        .btn-score:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(243,156,18,0.6);
        }
        
        .high-score {
            color: #FFD700;
            font-size: 14px;
            margin-top: 10px;
            text-align: center;
            text-shadow: 0 2px 10px rgba(255,215,0,0.3);
        }
        
        .status {
            color: rgba(255,255,255,0.7);
            font-size: 12px;
            text-align: center;
            margin-top: 10px;
        }
        
        @media (max-width: 640px) {
            .game-container {
                padding: 15px;
                border-radius: 16px;
            }
            
            canvas {
                width: 100%;
                height: auto;
            }
            
            .btn {
                padding: 10px 20px;
                font-size: 11px;
            }
            
            .score-display {
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    <div class="game-container">
        <div class="score-display">
            🎯 SCORE: <span id="scoreDisplay">0</span>
        </div>
        
        <canvas id="gameCanvas" width="400" height="600"></canvas>
        
        <div class="high-score" id="highScoreDisplay">
            🏆 HIGH SCORE: <span id="highScoreText">0</span>
        </div>
        
        <div class="controls">
            <button class="btn btn-start" id="startBtn">▶ START</button>
            <button class="btn btn-reset" id="resetBtn">⟳ RESET</button>
            <button class="btn btn-score" id="scoreBtn">📊 SCORES</button>
        </div>
        
        <div class="status" id="statusDisplay">
            Press SPACE or Click to flap
        </div>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const highScoreText = document.getElementById('highScoreText');
        const statusDisplay = document.getElementById('statusDisplay');

        // Game constants
        const GRAVITY = 0.5;
        const JUMP_FORCE = -10;
        const PIPE_WIDTH = 60;
        const PIPE_GAP = 180;
        const PIPE_SPEED = 3;
        const BIRD_RADIUS = 15;
        const GROUND_HEIGHT = 80;

        // Game state
        let gameId = null;
        let score = 0;
        let highScore = parseInt(localStorage.getItem('falfyBurdHighScore')) || 0;
        let bird = { x: 80, y: 300, velocity: 0 };
        let pipes = [];
        let gameOver = false;
        let started = false;
        let frameId = null;
        let frameCount = 0;

        highScoreText.textContent = highScore;

        // Utility functions
        function generateGameId() {
            return 'game_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
        }

        // Bird drawing
        function drawBird() {
            ctx.save();
            
            // Body (yellow with gradient)
            const gradient = ctx.createRadialGradient(
                bird.x - 5, bird.y - 5, 5,
                bird.x, bird.y, BIRD_RADIUS
            );
            gradient.addColorStop(0, '#FFD93D');
            gradient.addColorStop(0.7, '#F6B93B');
            gradient.addColorStop(1, '#E58E26');
            
            ctx.shadowColor = 'rgba(0,0,0,0.3)';
            ctx.shadowBlur = 15;
            
            ctx.beginPath();
            ctx.arc(bird.x, bird.y, BIRD_RADIUS, 0, Math.PI * 2);
            ctx.fillStyle = gradient;
            ctx.fill();
            ctx.shadowBlur = 0;
            
            // Eye
            ctx.beginPath();
            ctx.arc(bird.x + 6, bird.y - 5, 5, 0, Math.PI * 2);
            ctx.fillStyle = 'white';
            ctx.fill();
            ctx.beginPath();
            ctx.arc(bird.x + 8, bird.y - 7, 2.5, 0, Math.PI * 2);
            ctx.fillStyle = '#2d3436';
            ctx.fill();
            
            // Beak
            ctx.beginPath();
            ctx.moveTo(bird.x + 15, bird.y + 2);
            ctx.lineTo(bird.x + 25, bird.y + 6);
            ctx.lineTo(bird.x + 15, bird.y + 10);
            ctx.closePath();
            ctx.fillStyle = '#F39C12';
            ctx.fill();
            
            // Wing
            ctx.beginPath();
            ctx.ellipse(bird.x - 5, bird.y - 2, 8, 5, -0.3, 0, Math.PI * 2);
            ctx.fillStyle = '#E58E26';
            ctx.fill();
            
            ctx.restore();
        }

        // Pipe drawing
        function drawPipe(pipe) {
            ctx.save();
            
            // Top pipe
            const gradientTop = ctx.createLinearGradient(pipe.x, 0, pipe.x + PIPE_WIDTH, 0);
            gradientTop.addColorStop(0, '#2ecc71');
            gradientTop.addColorStop(0.5, '#27ae60');
            gradientTop.addColorStop(1, '#1e8449');
            
            ctx.shadowColor = 'rgba(0,0,0,0.2)';
            ctx.shadowBlur = 10;
            
            ctx.fillStyle = gradientTop;
            ctx.fillRect(pipe.x, 0, PIPE_WIDTH, pipe.top);
            
            // Top pipe cap
            ctx.fillStyle = '#27ae60';
            ctx.fillRect(pipe.x - 8, pipe.top - 25, PIPE_WIDTH + 16, 25);
            ctx.fillRect(pipe.x - 5, pipe.top - 30, PIPE_WIDTH + 10, 10);
            
            // Bottom pipe
            const gradientBottom = ctx.createLinearGradient(pipe.x, 0, pipe.x + PIPE_WIDTH, 0);
            gradientBottom.addColorStop(0, '#2ecc71');
            gradientBottom.addColorStop(0.5, '#27ae60');
            gradientBottom.addColorStop(1, '#1e8449');
            
            ctx.fillStyle = gradientBottom;
            ctx.fillRect(pipe.x, pipe.bottom, PIPE_WIDTH, canvas.height - pipe.bottom - GROUND_HEIGHT);
            
            // Bottom pipe cap
            ctx.fillStyle = '#27ae60';
            ctx.fillRect(pipe.x - 8, pipe.bottom, PIPE_WIDTH + 16, 25);
            ctx.fillRect(pipe.x - 5, pipe.bottom + 20, PIPE_WIDTH + 10, 10);
            
            ctx.restore();
        }

        // Ground drawing
        function drawGround() {
            ctx.save();
            
            // Main ground
            const gradient = ctx.createLinearGradient(0, canvas.height - GROUND_HEIGHT, 0, canvas.height);
            gradient.addColorStop(0, '#27ae60');
            gradient.addColorStop(0.3, '#229954');
            gradient.addColorStop(1, '#1e8449');
            
            ctx.fillStyle = gradient;
            ctx.fillRect(0, canvas.height - GROUND_HEIGHT, canvas.width, GROUND_HEIGHT);
            
            // Grass details
            ctx.fillStyle = '#2ecc71';
            for (let i = 0; i < canvas.width; i += 15) {
                const offset = (i + frameCount * 2) % 30;
                ctx.fillRect(i + offset, canvas.height - GROUND_HEIGHT - 2, 3, 6);
            }
            
            ctx.restore();
        }

        // Background drawing
        function drawBackground() {
            const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
            gradient.addColorStop(0, '#4a90d9');
            gradient.addColorStop(0.5, '#87CEEB');
            gradient.addColorStop(1, '#b8e6f0');
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, canvas.width, canvas.height - GROUND_HEIGHT);
            
            // Clouds
            ctx.save();
            ctx.fillStyle = 'rgba(255,255,255,0.3)';
            const cloudPositions = [
                {x: 50, y: 60, s: 1},
                {x: 200, y: 100, s: 1.2},
                {x: 350, y: 70, s: 0.8}
            ];
            cloudPositions.forEach(cloud => {
                const offset = (frameCount * 0.2 + cloud.x * 0.1) % 500 - 100;
                ctx.beginPath();
                ctx.arc(offset + cloud.x, cloud.y, 30 * cloud.s, 0, Math.PI * 2);
                ctx.arc(offset + cloud.x + 25 * cloud.s, cloud.y - 15 * cloud.s, 35 * cloud.s, 0, Math.PI * 2);
                ctx.arc(offset + cloud.x + 50 * cloud.s, cloud.y - 5 * cloud.s, 28 * cloud.s, 0, Math.PI * 2);
                ctx.fill();
            });
            ctx.restore();
        }

        // Game logic
        function resetGame() {
            bird.y = 300;
            bird.velocity = 0;
            pipes = [];
            score = 0;
            gameOver = false;
            started = false;
            frameCount = 0;
            scoreDisplay.textContent = '0';
            statusDisplay.textContent = 'Press SPACE or Click to flap';
            gameId = generateGameId();
            
            if (frameId) {
                cancelAnimationFrame(frameId);
                frameId = null;
            }
        }

        function startGame() {
            if (!started && !gameOver) {
                started = true;
                statusDisplay.textContent = '🕊️ Flying!';
                if (!frameId) {
                    gameLoop();
                }
            }
        }

        function flap() {
            if (gameOver) return;
            if (!started) {
                startGame();
                bird.velocity = JUMP_FORCE;
                return;
            }
            bird.velocity = JUMP_FORCE;
            // Small audio feedback visual
            bird.y -= 2;
        }

        function updateGame() {
            if (!started || gameOver) return;
            
            frameCount++;
            
            // Bird physics
            bird.velocity += GRAVITY;
            bird.y += bird.velocity;
            
            // Ground collision
            if (bird.y + BIRD_RADIUS > canvas.height - GROUND_HEIGHT) {
                bird.y = canvas.height - GROUND_HEIGHT - BIRD_RADIUS;
                gameOver = true;
                statusDisplay.textContent = '💥 Game Over! Press Reset';
                updateHighScore();
                return;
            }
            
            // Ceiling collision
            if (bird.y - BIRD_RADIUS < 0) {
                bird.y = BIRD_RADIUS;
                bird.velocity = 0;
            }
            
            // Pipe generation
            if (frameCount % 90 === 0) {
                const minTop = 80;
                const maxTop = canvas.height - GROUND_HEIGHT - PIPE_GAP - 80;
                const top = Math.random() * (maxTop - minTop) + minTop;
                pipes.push({
                    x: canvas.width,
                    top: top,
                    bottom: top + PIPE_GAP,
                    scored: false
                });
            }
            
            // Pipe movement and collision
            for (let i = pipes.length - 1; i >= 0; i--) {
                const pipe = pipes[i];
                pipe.x -= PIPE_SPEED;
                
                // Collision detection
                if (bird.x + BIRD_RADIUS > pipe.x && bird.x - BIRD_RADIUS < pipe.x + PIPE_WIDTH) {
                    if (bird.y - BIRD_RADIUS < pipe.top || bird.y + BIRD_RADIUS > pipe.bottom) {
                        gameOver = true;
                        statusDisplay.textContent = '💥 Game Over! Press Reset';
                        updateHighScore();
                        return;
                    }
                }
                
                // Score
                if (!pipe.scored && pipe.x + PIPE_WIDTH < bird.x) {
                    pipe.scored = true;
                    score++;
                    scoreDisplay.textContent = score;
                    
                    // Update high score if needed
                    if (score > highScore) {
                        highScore = score;
                        localStorage.setItem('falfyBurdHighScore', highScore.toString());
                        highScoreText.textContent = highScore;
                    }
                }
                
                // Remove off-screen pipes
                if (pipe.x + PIPE_WIDTH < 0) {
                    pipes.splice(i, 1);
                }
            }
        }

        function updateHighScore() {
            if (score > highScore) {
                highScore = score;
                localStorage.setItem('falfyBurdHighScore', highScore.toString());
                highScoreText.textContent = highScore;
            }
        }

        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            drawBackground();
            
            // Draw pipes
            pipes.forEach(pipe => drawPipe(pipe));
            
            drawGround();
            
            drawBird();
            
            // Game over overlay
            if (gameOver) {
                ctx.save();
                ctx.fillStyle = 'rgba(0,0,0,0.5)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                
                ctx.fillStyle = 'white';
                ctx.font = '30px "Press Start 2P", cursive';
                ctx.textAlign = 'center';
                ctx.fillText('GAME OVER', canvas.width/2, canvas.height/2 - 20);
                
                ctx.font = '16px "Press Start 2P", cursive';
                ctx.fillStyle = '#FFD700';
                ctx.fillText(`Score: ${score}`, canvas.width/2, canvas.height/2 + 40);
                ctx.restore();
            }
            
            // Start prompt
            if (!started && !gameOver) {
                ctx.save();
                ctx.fillStyle = 'rgba(0,0,0,0.3)';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                
                ctx.fillStyle = 'white';
                ctx.font = '20px "Press Start 2P", cursive';
                ctx.textAlign = 'center';
                ctx.fillText('🕊️ READY', canvas.width/2, canvas.height/2);
                
                ctx.font = '14px "Press Start 2P", cursive';
                ctx.fillStyle = '#FFD700';
                ctx.fillText('Click or SPACE', canvas.width/2, canvas.height/2 + 50);
                ctx.restore();
            }
        }

        function gameLoop() {
            updateGame();
            render();
            frameId = requestAnimationFrame(gameLoop);
        }

        // Event listeners
        canvas.addEventListener('click', flap);
        document.addEventListener('keydown', (e) => {
            if (e.code === 'Space') {
                e.preventDefault();
                flap();
            }
        });

        document.getElementById('startBtn').addEventListener('click', () => {
            resetGame();
            startGame();
        });

        document.getElementById('resetBtn').addEventListener('click', () => {
            resetGame();
            render();
            statusDisplay.textContent = '🔄 Reset! Click or SPACE to start';
        });

        document.getElementById('scoreBtn').addEventListener('click', async () => {
            if (!gameId) {
                gameId = generateGameId();
            }
            
            try {
                const response = await fetch('/api/scores', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        game_id: gameId,
                        score: score
                    })
                });
                
                const data = await response.json();
                if (data.success) {
                    statusDisplay.textContent = `✅ Score saved! Total: ${data.total_scores}`;
                } else {
                    statusDisplay.textContent = '❌ Failed to save score';
                }
            } catch (error) {
                console.error('Error saving score:', error);
                statusDisplay.textContent = '❌ Error saving score';
            }
        });

        // Initial render
        resetGame();
        render();

        // Prevent scrolling with space
        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space') {
                e.preventDefault();
            }
        });
    </script>
</body>
</html>
"""

@app.get("/", response_class=HTMLResponse)
async def get_game():
    """Serve the game HTML"""
    return HTML_TEMPLATE

@app.post("/api/scores", status_code=status.HTTP_201_CREATED)
async def save_score(score_data: ScoreRequest):
    """Save a game score"""
    try:
        if score_data.game_id not in scores:
            scores[score_data.game_id] = []
        scores[score_data.game_id].append({
            "score": score_data.score,
            "timestamp": datetime.now().isoformat()
        })
        return {
            "success": True,
            "game_id": score_data.game_id,
            "score": score_data.score,
            "total_scores": len(scores[score_data.game_id])
        }
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Failed to save score: {str(e)}"
        )

@app.get("/api/scores/{game_id}")
async def get_game_scores(game_id: str):
    """Get all scores for a game"""
    if game_id not in scores:
        return {"game_id": game_id, "scores": [], "total": 0}
    return {
        "game_id": game_id,
        "scores": scores[game_id],
        "total": len(scores[game_id])
    }

@app.get("/api/highscore")
async def get_global_highscore():
    """Get global high score across all games"""
    all_scores = []
    for game_scores in scores.values():
        all_scores.extend([s["score"] for s in game_scores])
    if not all_scores:
        return {"high_score": 0, "total_games": 0, "total_scores": 0}
    return {
        "high_score": max(all_scores),
        "total_games": len(scores),
        "total_scores": len(all_scores)
    }

# Generic CRUD endpoints for API testing compatibility
@app.post("/api/items", status_code=status.HTTP_201_CREATED)
async def create_item(item: Item):
    """Create a new item (for generic CRUD testing)"""
    item_id = str(uuid.uuid4())
    items[item_id] = {
        "id": item_id,
        **item.model_dump(),
        "created_at": datetime.now().isoformat()
    }
    return {
        "success": True,
        "item": items[item_id],
        "message": "Item created successfully"
    }

@app.get("/api/items")
async def get_items():
    """Get all items (for generic CRUD testing)"""
    return {
        "items": list(items.values()),
        "total": len(items)
    }

@app.get("/api/items/{item_id}")
async def get_item(item_id: str):
    """Get a specific item (for generic CRUD testing)"""
    if item_id not in items:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Item with id {item_id} not found"
        )
    return {"item": items[item_id]}

@app.put("/api/items/{item_id}")
async def update_item(item_id: str, item: Item):
    """Update an item (for generic CRUD testing)"""
    if item_id not in items:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Item with id {item_id} not found"
        )
    items[item_id].update(item.model_dump())
    items[item_id]["updated_at"] = datetime.now().isoformat()
    return {
        "success": True,
        "item": items[item_id],
        "message": "Item updated successfully"
    }

@app.delete("/api/items/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_item(item_id: str):
    """Delete an item (for generic CRUD testing)"""
    if item_id not in items:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Item with id {item_id} not found"
        )
    del items[item_id]
    return None

@app.get("/api/health")
async def health_check():
    """Health check endpoint"""
    return {
        "status": "healthy",
        "game": "Falfy Burd",
        "version": "1.0.0",
        "active_games": len(scores),
        "total_scores": sum(len(s) for s in scores.values()),
        "total_items": len(items)
    }

@app.get("/api/docs/info")
async def api_info():
    """API information endpoint"""
    return {
        "name": "Falfy Burd Game API",
        "version": "1.0.0",
        "endpoints": {
            "game": {
                "GET /": "Play the game",
                "POST /api/scores": "Save a game score",
                "GET /api/scores/{game_id}": "Get scores for a game",
                "GET /api/highscore": "Get global high score"
            },
            "crud": {
                "POST /api/items": "Create an item",
                "GET /api/items": "List all items",
                "GET /api/items/{item_id}": "Get an item",
                "PUT /api/items/{item_id}": "Update an item",
                "DELETE /api/items/{item_id}": "Delete an item"
            },
            "system": {
                "GET /api/health": "Health check",
                "GET /api/docs/info": "API information"
            }
        }
    }

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(
        app,
        host="127.0.0.1",
        port=8000,
        log_level="info"
    )