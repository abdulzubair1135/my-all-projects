from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel
from typing import List, Dict, Optional
import random
import json
from fastapi.middleware.cors import CORSMiddleware

app = FastAPI(title="Snake Game API", description="Full-stack Snake Game with leaderboard")

# Enable CORS for development
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Game state storage
class GameState:
    def __init__(self):
        self.board_size = 20
        self.snake = [(10, 10), (9, 10), (8, 10)]
        self.direction = "RIGHT"
        self.food = None
        self.score = 0
        self.game_over = False
        self.won = False
        self.spawn_food()
    
    def spawn_food(self):
        """Spawn food at random position not occupied by snake"""
        while True:
            x = random.randint(0, self.board_size - 1)
            y = random.randint(0, self.board_size - 1)
            if (x, y) not in self.snake:
                self.food = (x, y)
                break
    
    def move(self):
        """Move snake one step in current direction"""
        if self.game_over or self.won:
            return
        
        head = self.snake[0]
        new_head = None
        
        if self.direction == "UP":
            new_head = (head[0], head[1] - 1)
        elif self.direction == "DOWN":
            new_head = (head[0], head[1] + 1)
        elif self.direction == "LEFT":
            new_head = (head[0] - 1, head[1])
        elif self.direction == "RIGHT":
            new_head = (head[0] + 1, head[1])
        
        # Check wall collision
        if (new_head[0] < 0 or new_head[0] >= self.board_size or 
            new_head[1] < 0 or new_head[1] >= self.board_size):
            self.game_over = True
            return
        
        # Check self collision
        if new_head in self.snake:
            self.game_over = True
            return
        
        # Move snake
        self.snake.insert(0, new_head)
        
        # Check food collision
        if new_head == self.food:
            self.score += 1
            if len(self.snake) == self.board_size * self.board_size:
                self.won = True
            else:
                self.spawn_food()
        else:
            self.snake.pop()
    
    def change_direction(self, new_direction):
        """Change snake direction with validation"""
        opposites = {"UP": "DOWN", "DOWN": "UP", "LEFT": "RIGHT", "RIGHT": "LEFT"}
        if new_direction in opposites and opposites[new_direction] != self.direction:
            self.direction = new_direction
        elif new_direction not in opposites:
            self.direction = new_direction

# In-memory game sessions and leaderboard
games: Dict[str, GameState] = {}
leaderboard: List[Dict] = []

class MoveRequest(BaseModel):
    game_id: str
    direction: str

class GameResponse(BaseModel):
    game_id: str
    board: List[List[int]]
    snake: List[List[int]]
    food: List[int]
    score: int
    game_over: bool
    won: bool

@app.get("/", response_class=HTMLResponse)
async def get_game():
    """Serve the main game HTML page"""
    html_content = """
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>🐍 Snake Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');
        * { font-family: 'Inter', sans-serif; }
